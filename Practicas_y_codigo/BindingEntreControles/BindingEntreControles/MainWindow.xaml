<Window x:Class="BindingEntreControles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BindingEntreControles"
        mc:Ignorable="d"
        Title="Binding entre controles" Height="450" Width="800">

    <Window.Resources>
        <local:TamañoConverter x:Key="Conversor"/>
    </Window.Resources>
    
    <StackPanel>
        
        <TextBox x:Name="tamañoTextBox" 
                 Width="50" 
                 Margin="5" 
                 Text=""
                 HorizontalAlignment="Left"/>

        <TextBox x:Name="tdobleTextBox" 
                Width="50" 
                Margin="5" 
                Text="{Binding ElementName=colorTextBox, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource Conversor}}"
                HorizontalAlignment="Left"/>

        <Label FontSize="{Binding ElementName=tamañoTextBox, Path=Text, Mode=TwoWay}"
               Margin="5"
               Content="Hola 2DAM-B"
               ></Label>
        
    </StackPanel>
</Window>
