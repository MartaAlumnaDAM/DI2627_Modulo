<Window x:Class="DemoObjetoNegocio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoObjetoNegocio"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel x:Name="PrimerStackPanel">
        <Label Content="Nombre"
               Margin="5,20,5,0"
               HorizontalAlignment="Left"></Label>
        <TextBox x:Name="nombreTextBox"
                 Margin="5,0,5,10"
                 Width="150"
                 HorizontalAlignment="Left"
                 Text="{Binding Path=Nombre}"></TextBox>

        <Label Content="Edad"
        Margin="5,5,5,0"
       HorizontalAlignment="Left"></Label>
        <TextBox x:Name="edadTextBox"
         Margin="5,0,5,20"
         Width="50"
         HorizontalAlignment="Left"
         Text="{Binding Path=Edad}"></TextBox>
        
        <Button x:Name="button"
            Content="Consultar / Actualizar OBJETO"
                Margin="5"
                Width="200"
                Padding="5"
                HorizontalAlignment="Left"
                Click="button_Click"></Button>

    </StackPanel>
</Window>
